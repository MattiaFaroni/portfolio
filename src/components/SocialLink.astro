---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  class="social-icon-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <slot />
</a>

<style>
  .social-icon-link {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: rgba(248, 250, 252, 0.9);
    opacity: 0.78;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease,
      filter 0.2s ease;
    position: relative;
    z-index: 1;
  }

  .social-icon-link:hover {
    opacity: 1;
    transform: translateY(-2px);
    filter: drop-shadow(0 6px 14px rgba(34, 211, 238, 0.18));
  }
</style>
