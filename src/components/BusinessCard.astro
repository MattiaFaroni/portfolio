---
import CardFront from './CardFront.astro';
import CardBack from './CardBack.astro';
import { db } from '../lib/database';
---

<div class="card-stack">
  <div class="shadow-container">
    <div class="dynamic-shadow" id="shadow"></div>

    <div
      class="card-inner"
      id="card"
      role="button"
      tabindex="0"
      aria-label="Profile card. Click to flip."
      aria-pressed="false"
      data-email={db.email}
    >
      <CardFront />
      <CardBack />
    </div>
  </div>

  <div class="hint">Click or tap to spin</div>
</div>

<script>
  const card = document.getElementById('card') as HTMLElement;
  const shadow = document.getElementById('shadow') as HTMLElement;

  let isFlipped = false;
  let isPointerDown = false;

  const MAX_TILT = 10;

  function setCardTransform(tiltX = 0, tiltY = 0, isInteractive = false) {
    if (isInteractive) {
      card.style.transition = 'transform 0.22s cubic-bezier(0.25, 1, 0.5, 1)';
      shadow.style.transition =
        'transform 0.22s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.22s cubic-bezier(0.25, 1, 0.5, 1)';
    } else {
      card.style.transition = 'transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1)';
      shadow.style.transition =
        'transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 1.1s cubic-bezier(0.2, 0.8, 0.2, 1)';
    }

    const baseY = isFlipped ? 180 : 0;
    const effY = isFlipped ? -tiltY : tiltY;
    card.style.transform = `rotateY(${baseY}deg) rotateX(${tiltX}deg) rotateY(${effY}deg)`;
  }

  function applyTilt(x: number, y: number) {
    const tiltX = (y - 0.5) * (MAX_TILT * 1.4);
    const tiltY = (x - 0.5) * -MAX_TILT;

    setCardTransform(tiltX, tiltY, true);

    const sY = isFlipped ? -tiltY : tiltY;
    shadow.style.transform = `translateX(${sY * -1.1}px) translateY(${tiltX * 0.5}px) scale(1.03)`;
    shadow.style.opacity = '0.90';
  }

  function resetTilt() {
    setCardTransform(0, 0, false);
    shadow.style.transform = 'translateX(0) translateY(0) scale(1)';
    shadow.style.opacity = '0.80';
  }

  function toggleFlip() {
    isFlipped = !isFlipped;
    card.classList.toggle('is-flipped', isFlipped);
    card.setAttribute('aria-pressed', String(isFlipped));
    resetTilt();
  }

  function isInsideLink(t: EventTarget | null) {
    return !!(t as HTMLElement)?.closest?.('a');
  }

  card.addEventListener('pointerdown', (e) => {
    if (isInsideLink(e.target)) return;
    isPointerDown = true;
    card.setPointerCapture?.(e.pointerId);
  });

  card.addEventListener('pointermove', (e) => {
    if (isInsideLink(e.target)) return;
    if (e.pointerType !== 'mouse' && !isPointerDown) return;
    const r = card.getBoundingClientRect();
    const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    applyTilt(x, y);
  });

  card.addEventListener('pointerup', (e) => {
    if (isInsideLink(e.target)) return;
    isPointerDown = false;
    resetTilt();
  });

  card.addEventListener('pointercancel', () => {
    isPointerDown = false;
    resetTilt();
  });

  card.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'mouse') resetTilt();
  });

  card.addEventListener('click', (e) => {
    if (isInsideLink(e.target)) return;
    toggleFlip();
  });

  card.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      toggleFlip();
    }
  });

  resetTilt();
</script>

<style>
  .card-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
  }

  .shadow-container {
    position: relative;
    width: min(
      var(--w),
      88vw,
      calc((100svh - 96px) * var(--ratio-w) / var(--ratio-h))
    );
    aspect-ratio: calc(var(--ratio-w) / var(--ratio-h));
    height: auto;
    container-type: inline-size;
  }

  .dynamic-shadow {
    position: absolute;
    width: 90%;
    height: 20px;
    bottom: -24px;
    left: 5%;
    background: rgba(0, 0, 0, 0.95);
    filter: blur(20px);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.8;
    will-change: transform, opacity;
  }

  .card-inner {
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    cursor: pointer;
    will-change: transform;
    outline: none;
    touch-action: manipulation;
  }

  .card-inner:focus-visible {
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.35);
    border-radius: var(--radius);
  }

  .hint {
    margin-top: 2px;
    text-align: center;
    color: #475569;
    font-size: clamp(11px, 2.3vw, 14px);
    letter-spacing: 0.4px;
    font-weight: 500;
  }
</style>
